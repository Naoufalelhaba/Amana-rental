# Session JWT (générer avec: openssl rand -base64 32)
SESSION_SECRET=

# Upstash Redis — obtenir depuis Vercel > Integrations > Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email Gmail App Password
EMAIL_PASS=

# URL publique du site
NEXT_PUBLIC_SITE_URL=https://votre-domaine.vercel.app

# Secret pour la route /api/seed (une chaîne aléatoire longue)
SEED_SECRET=
